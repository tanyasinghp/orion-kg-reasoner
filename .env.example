# LLM — Ollama (default: llama3.1)
KGR_LLM__PROVIDER=ollama
KGR_LLM__OLLAMA__MODEL_NAME=llama3.1
KGR_LLM__OLLAMA__TEMPERATURE=0.0

# Flavor
KGR_FLAVOR=amazon

# Knowledge Graph — In-memory rdflib (default, no external deps)
# Switch to fuseki when Docker is available:
#   KGR_KNOWLEDGE_GRAPH__TYPE=fuseki
#   KGR_KNOWLEDGE_GRAPH__HOST=http://localhost:3030
KGR_KNOWLEDGE_GRAPH__TYPE=rdflib

# Vector Database — FAISS
KGR_VECTOR_DB__TYPE=faiss
KGR_VECTOR_DB__FAISS_INDEX_PATH=data/indices/entity_embeddings.index
KGR_VECTOR_DB__FAISS_MAPPING_PATH=data/indices/uri_mapping.json
KGR_VECTOR_DB__EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Optional: OpenAI-compatible API (alternative to Ollama)
# KGR_LLM__PROVIDER=openai-compatible
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=...
